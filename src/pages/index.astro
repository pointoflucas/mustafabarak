---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/url';

const projects = await getCollection('projects');
const articles = await getCollection('writing');

const featuredProjects = projects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const publishedArticles = articles
  .filter(a => !a.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<BaseLayout title="Home">
  <section class="intro">
    <h1>Mustafa Barak</h1>
    <p>
      Working at the intersection of data systems, software engineering,
      and applied AI.
    </p>
    <p>
      Over the years I've worked on data platforms, ML systems, RAG and
      agentic AI across pharma, retail, finance, and venture capital.
    </p>
  </section>

  {featuredProjects.length > 0 && (
    <section class="section">
      <h2>Projects</h2>
      <div class="project-list">
        {featuredProjects.map(project => (
          <a class="project-row" href={withBase(`/projects/${project.slug}`)}>
            <div class="card-header">
              <h3>{project.data.title}</h3>
              <span class="year">{project.data.year}</span>
            </div>
            <p>{project.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {publishedArticles.length > 0 && (
    <section class="section">
      <h2>Writing</h2>
      <div class="writing-list">
        {publishedArticles.map(article => (
          <a class="writing-row" href={withBase(`/writing/${article.slug}`)}>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .intro {
    margin-bottom: 3.5rem;
  }

  h1 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .intro p {
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    max-width: 600px;
  }

  .section {
    margin-bottom: 2.5rem;
  }

  h2 {
    margin-top: 0;
    margin-bottom: 1.25rem;
    font-size: 1.3rem;
  }

  .project-list,
  .writing-list {
    border-top: 1px solid var(--border-color);
  }

  .project-row,
  .writing-row {
    display: block;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
    text-decoration: none;
    color: inherit;
    transition: color 0.2s;
  }

  .project-row:hover,
  .writing-row:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-row h3,
  .writing-row h3 {
    margin: 0;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .project-row:hover h3,
  .writing-row:hover h3 {
    color: var(--accent);
  }

  .project-row p,
  .writing-row p {
    margin: 0.4rem 0 0 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .year {
    color: var(--text-secondary);
    font-size: 0.85rem;
    flex-shrink: 0;
  }
</style>
