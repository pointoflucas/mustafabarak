---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/url';

const projects = await getCollection('projects');
const articles = await getCollection('writing');

const featuredProjects = projects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const publishedArticles = articles
  .filter(a => !a.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<BaseLayout title="Home">
  <section class="intro">
    <span class="eyebrow">Data & AI Engineer</span>
    <h1>Mustafa Barak</h1>
    <p>
      Working at the intersection of data systems, software engineering,
      and applied AI.
    </p>
    <p>
      Over the years I've worked on data platforms, ML systems, RAG and
      agentic AI across pharma, retail, finance, and venture capital.
    </p>
  </section>

  {featuredProjects.length > 0 && (
    <section class="section">
      <h2>Projects</h2>
      <div class="cards">
        {featuredProjects.map(project => (
          <a class="card" href={withBase(`/projects/${project.slug}`)}>
            <div class="card-header">
              <h3>{project.data.title}</h3>
              <span class="year">{project.data.year}</span>
            </div>
            <p class="card-desc">{project.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {publishedArticles.length > 0 && (
    <section class="section">
      <h2>Writing</h2>
      <div class="cards">
        {publishedArticles.map(article => (
          <a class="card" href={withBase(`/writing/${article.slug}`)}>
            <h3>{article.data.title}</h3>
            <p class="card-desc">{article.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .intro {
    margin-bottom: 3.5rem;
  }

  .eyebrow {
    display: inline-block;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.5rem;
  }

  h1 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .intro p {
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    max-width: 600px;
  }

  .section {
    margin-bottom: 2.5rem;
  }

  h2 {
    margin-top: 0;
    margin-bottom: 1.25rem;
    font-size: 1.3rem;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card {
    display: block;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background-color: var(--bg-secondary);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .card:hover h3 {
    color: var(--accent);
  }

  .card-desc {
    margin: 0.4rem 0 0 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .year {
    color: var(--text-secondary);
    font-size: 0.85rem;
    flex-shrink: 0;
  }
</style>
