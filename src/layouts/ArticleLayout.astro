---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}

const { title, description, date, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const readingTime = Math.ceil(
  (Astro.slots.render('default')?.then(html => html.split(' ').length / 200) || 0)
);
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">{formattedDate}</p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map(tag => (
            <a href={`/writing?tag=${tag}`} class="tag">
              {tag}
            </a>
          ))}
        </div>
      )}
    </header>
    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    margin: 2rem 0;
  }

  header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
  }

  h1 {
    margin: 0 0 0.5rem 0;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .meta {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background-color: var(--bg-secondary);
    border-radius: 0.25rem;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
  }

  .tag:hover {
    background-color: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .content {
    margin-top: 2rem;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  :global(.content h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  :global(.content h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }

  :global(.content p) {
    margin-bottom: 1rem;
  }

  :global(.content ul, .content ol) {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }

  :global(.content li) {
    margin-bottom: 0.5rem;
  }

  :global(.content blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    color: var(--text-secondary);
  }

  :global(.content code) {
    background-color: var(--bg-secondary);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
  }

  :global(.content pre) {
    background-color: var(--bg-secondary);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  :global(.content pre code) {
    background: none;
    padding: 0;
  }
</style>
